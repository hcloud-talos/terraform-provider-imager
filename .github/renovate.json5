{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":automergeMinor"],
  assignees: ["mrclrchtr"],
  prHourlyLimit: 0,
  rangeStrategy: "bump",
  ignorePaths: [
    "examples/**",
  ],
  packageRules: [
    {
      matchManagers: ["gomod"],
      postUpdateOptions: ["gomodTidy"],
    },
    {
      description: "Group Terraform plugin dependencies that must be updated together",
      matchPackageNames: [
        "github.com/hashicorp/terraform-plugin-framework",
        "github.com/hashicorp/terraform-plugin-go",
        "github.com/hashicorp/terraform-plugin-sdk/v2",
        "github.com/hashicorp/terraform-plugin-testing",
        "github.com/hashicorp/terraform-plugin-mux",
        "github.com/hashicorp/terraform-plugin-framework-timeouts",
        "github.com/hashicorp/terraform-plugin-framework-validators",
      ],
      groupName: "terraform-plugin dependencies",
    },
    {
      matchManagers: ["terraform"],
      semanticCommitType: "fix",
    },
    {
      matchPackageNames: ["hashicorp/terraform"],
      rangeStrategy: "widen",
    },
    {
      matchDepTypes: ["action"],
      pinDigests: true,
      automerge: true,
    },
  ],
  customManagers: [
    {
      description: "Update go run/install/tool dependencies in mise.toml and CI scripts",
      customType: "regex",
      managerFilePatterns: ["/^(mise\.toml|\\.github/workflows/.+\\.ya?ml|scripts/.+\\.sh)$/"],
      matchStrings: [
        "go (?:run|install|tool) (?<depName>[^@\\s]+)@(?<currentValue>[^\\s]+)",
      ],
      datasourceTemplate: "go",
    },
    {
      description: "Update semantic-release in GitHub Action workflows",
      customType: "regex",
      managerFilePatterns: ["/^\\.github\\/(actions|workflows)\\/.+\\.ya?ml$/"],
      matchStrings: [
        "semantic_version\\s*:\\s*(\"|')?(?<currentValue>.+)(\"|'|(\\s+)|\\n|$)",
      ],
      datasourceTemplate: "npm",
      depNameTemplate: "semantic-release",
    },
    {
      description: "Update conventional-changelog-conventionalcommits in GitHub Action workflows",
      customType: "regex",
      managerFilePatterns: ["/^\\.github\\/(actions|workflows)\\/.+\\.ya?ml$/"],
      matchStrings: [
        ".*(?<depName>conventional-changelog-conventionalcommits)@(?<currentValue>.+?)(\"|'|(\\s+)|\\n|$)",
      ],
      datasourceTemplate: "npm",
      depNameTemplate: "conventional-changelog-conventionalcommits",
    },
  ],
}
